# Copy to terraform.tfvars (git-ignored) and fill in.

region = "us-east-1"
name   = "astra"

# A public Route 53 hosted zone in this account.
domain = "lab.example.com"

# Your public IP, from:  curl -s https://checkip.amazonaws.com
admin_cidrs = ["203.0.113.7/32"]

# Your fork of the course repo. Argo CD reads 2-platform/addons from here.
repo_url      = "https://github.com/kserge2001/self-hosted-llm-qwen-27b.git"
repo_revision = "main"
